export module Warmup2;

import std;

void ToggleChar(char& c);


export namespace wu2
{
	std::optional<std::vector<std::string>> ReadLines(const std::filesystem::path& fileName)
	{
		std::ifstream file(fileName);
		if (!file)
			return std::nullopt;

		std::vector<std::string> lines;
		std::string line;
		while (std::getline(file, line))
		{
			lines.push_back(line);
		}
		return lines;
	}

	void PrintLines(const std::vector<std::string>& lines)
	{
		for (const auto& line : lines)
		{
			std::cout << line << std::endl;
		}
	}

	std::vector<std::string> SplitWords(const std::string& line)
	{
		auto words = line
			| std::views::split(' ')
			| std::views::filter([](auto r) {
			return !r.empty(); })
			| std::views::transform([](auto r) { 
				return std::string(r.begin(), r.end()); })
			| std::ranges::to<std::vector>();
		
		return words;
	}


	void TogleCase(auto& words)
	{
		for (auto& word : words)
		{
			auto togle = word
				| std::views::transform([](auto r) {
				return ToggleChar(r); });
		}
	}
}


// Helper

char ToggleChar(char c)
{
	char result;
	if (std::isupper(c))
		result = std::tolower(c);
	else if (std::islower(c))
		result = std::isupper(c);
	return result;
}
